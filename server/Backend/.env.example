# Copy this file to .env (for local development) and fill in your own values.
# On Render, add the same variables under Environment. Never commit the real .env file.

# MongoDB connection string (create a NEW database user/password: the old one was published on GitHub)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Port for local development (Render sets PORT automatically)
PORT=1509

# Long random strings. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXPRESS_SESSION_SECRET=
JWT_KEY=

# "production" on Render. Leave empty locally. (On Render, production mode is also detected automatically.)
NODE_ENV=

# Frontends allowed to call the API (comma separated)
CLIENT_ORIGINS=https://competitivecodingarena.onrender.com,http://localhost:5173

# Gmail account that sends the OTP emails. EMAIL_PASS is a Gmail "app password", not the normal password.
# Locally you can leave these empty: the OTP is then printed in the server console instead of emailed.
EMAIL_USER=
EMAIL_PASS=

# Admin panel login (/admin). Admin login is disabled while these are empty.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: match length in milliseconds (default 600000 = 10 minutes)
MATCH_DURATION_MS=
